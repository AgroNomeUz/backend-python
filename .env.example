# Every variable agro/settings.py reads. Copy to .env and fill in; no real values here.

SECRET_KEY=
DEBUG=False
# development | production. Production turns off the OTP and billing mocks.
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Seconds to keep database connections open; 0 closes them after each request.
CONN_MAX_AGE=0

# Refresh-token cookie (optional; defaults in settings.py)
AUTH_REFRESH_COOKIE_NAME=agro_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=

# Developing without an SMS gateway. Both are refused in production.
OTP_DEV_CODE=000000
OTP_TEST_PHONES=
OTP_ECHO_CODES=False

BILLING_GATEWAY=mock
# Development only: lets the mock provider declare payments received.
BILLING_MOCK_ENABLED=
BILLING_COMMISSION_RATE=0.015
BILLING_CONTRACT_COMMISSION_RATE=0.01
BILLING_PAYOUT_COOLDOWN_HOURS=24
